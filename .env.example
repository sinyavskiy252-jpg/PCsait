# Firebase Web SDK configuration for local development.
# Copy this file to .env and fill in the values from Firebase Console.
# VITE_* values are included in the browser bundle; they are public client settings,
# not service-account credentials or server-side secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
